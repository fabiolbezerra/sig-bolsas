<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">
    <persistence-unit name="SigBolsasPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <!--<non-jta-data-source>java:comp/env/jdbc/SigBolsasDB</non-jta-data-source>-->
        <class>br.edu.ufra.entidade.Pessoa</class>
        <class>br.edu.ufra.entidade.PessoaPapel</class>
        <class>br.edu.ufra.entidade.Papel</class>
        <class>br.edu.ufra.entidade.Comite</class>
        <class>br.edu.ufra.entidade.ComitePessoa</class>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/sig_bolsas_bd"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="ufraneta"/>

            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
        </properties>
    </persistence-unit>
</persistence>
